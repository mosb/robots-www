# Ignore docs files
_gh_pages
_site
.ruby-version

# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.zip
*.vi
*~

# OS or Editor folders
.DS_Store
._*
Thumbs.db
.cache
.project
.settings
.tmproj
*.esproj
nbproject
*.sublime-project
*.sublime-workspace
.idea

# Komodo
*.komodoproject
.komodotools

# grunt-html-validation
validation-status.json
validation-report.json

# Folders to ignore
node_modules
public/ico/GitHub-Logos/
public/ico/GitHub-Mark/
public/ico/g+icon_grey/
public/ico/g+icon_white/
_bibliography/Exported Items.bib
page.html
public/ico/mail.ico
public/pdf/

# Lecture videos and large media (host externally, never track)
*.mp4
*.mov
*.m4v

# Ruby / Bundler build artefacts
.bundle/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
vendor/

# Saved-webpage junk (Elsevier page dumps)
**/svg+xml;charset=*

# Editor config
.vscode/

# Zotero export folders; the site builds from the *_bib.bib files
_bibliography/*/
_bibliography/zotero_export_*.bib

# Local utility script
math-with-slack.sh

# Icons, images and teaching materials, deployed alongside public/pdf/
public/ico/
public/image/
teaching/
